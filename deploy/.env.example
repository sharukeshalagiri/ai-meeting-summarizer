# Copy to deploy/.env on the server and fill in. NEVER commit the copy
# (the repo ignores **/.env, so deploy/.env stays out of git; keep that name).
#
#   docker compose -f docker-compose.prod.yml --env-file deploy/.env up -d --build

# Public hostname. DNS must point at this server for HTTPS to work.
DOMAIN=meetings.example.com

# Database (internal to the compose network; never published).
POSTGRES_USER=postgres
POSTGRES_PASSWORD=change-me-long-random
POSTGRES_DB=ai_meeting_summarizer

# Required by the backend.
GEMINI_API_KEY=
# Bearer token for /api/live (extension + desktop recorder). Generate with:
#   openssl rand -hex 32
DEVICE_TOKEN=

# Optional.
LOG_LEVEL=info
# CORS_ORIGIN defaults to https://$DOMAIN.
# CORS_ORIGIN=
WHISPER_MODEL=small
WHISPER_LANGUAGE=
AI_SERVICE_MEMORY_LIMIT=2g
# local (ai-service, free) or deepgram (paid per audio minute).
TRANSCRIPTION_PROVIDER=local
DEEPGRAM_API_KEY=
# Tag for the locally built images; bump it to keep the previous build for rollback.
IMAGE_TAG=latest
