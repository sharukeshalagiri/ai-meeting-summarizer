# Root .env: read only by docker compose. Copy to .env if you need to
# change a default. Each service has its own .env (backend/, frontend/,
# ai-service/).

# Host port the Postgres container listens on. 5433 avoids a locally
# installed PostgreSQL on 5432.
# POSTGRES_PORT=5433
# POSTGRES_USER=postgres
# POSTGRES_PASSWORD=postgres
# Database created on first container start. Worktrees use their own
# database names in backend/.env; Prisma creates those on migrate.
# POSTGRES_DB=ai_meeting_summarizer
