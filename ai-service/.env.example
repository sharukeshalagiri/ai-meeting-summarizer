# Copy to ai-service/.env. Read by scripts/ai-service.mjs (npm run dev:ai).

# Port uvicorn listens on. backend/.env AI_SERVICE_URL must point here.
# AI_SERVICE_PORT=8000

# faster-whisper model: tiny | base | small | medium | large-v3 | distil-large-v3
# WHISPER_MODEL=small
# auto (CUDA when a GPU is visible, else CPU) | cpu | cuda
# WHISPER_DEVICE=auto
# Precision override. Default: int8 on CPU, float16 on CUDA.
# WHISPER_COMPUTE_TYPE=
# ISO 639-1 code (e.g. en). Empty = auto-detect per chunk.
# WHISPER_LANGUAGE=

# Speaker diarization (w2-spk, POST /diarize).
# sherpa (default; ONNX, CPU, no torch) | pyannote (optional; needs torch,
# pyannote.audio, HF_TOKEN and the model's licence accepted on Hugging Face)
# DIARIZATION_ENGINE=sherpa
# Speaker-embedding model name (downloaded on first use into
# diarization/.models/) or a path to a local .onnx file.
# SPEAKER_EMBEDDING_MODEL=wespeaker_en_voxceleb_resnet34_LM
# SPEAKER_MODEL_DIR=
# SPEAKER_EMBEDDING_THREADS=1
# HF_TOKEN=
