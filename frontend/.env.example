# Copy to frontend/.env.local (gitignored via *.local).

# Backend API base URL, including /api. Must match backend PORT.
# VITE_API_URL=http://localhost:5000/api

# Port for the Vite dev server (read by vite.config.ts).
# FRONTEND_PORT=5173

# VITE_DEVICE_TOKEN is no longer used (w4-acct): the web app signs in
# with a session cookie, and recorders use tokens from the Devices page.
