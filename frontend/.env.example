# Copy to frontend/.env.local (gitignored via *.local).

# Backend API base URL, including /api. Must match backend PORT.
# VITE_API_URL=http://localhost:5000/api

# Port for the Vite dev server (read by vite.config.ts).
# FRONTEND_PORT=5173

# Must equal the backend's DEVICE_TOKEN when that is set; leave unset for
# a development backend without one. Visible in the built bundle.
# VITE_DEVICE_TOKEN=
