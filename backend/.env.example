# Copy to backend/.env and fill in real values. Never commit .env.

# --- required ---

# PostgreSQL connection string. Matches docker-compose.yml defaults
# (host port 5433). Give each git worktree its own database name, e.g.
# ai_meeting_summarizer_feat_auth (see CLAUDE.md, "Parallel worktrees").
DATABASE_URL="postgresql://postgres:postgres@localhost:5433/ai_meeting_summarizer"

# Google AI Studio API key (https://aistudio.google.com/apikey)
GEMINI_API_KEY=

# --- optional (defaults shown) ---

# NODE_ENV=development
# HTTP port. Change per worktree and update frontend VITE_API_URL to match.
# PORT=5000
# debug | info | warn | error (default: debug, info in production)
# LOG_LEVEL=debug

# Gemini models
# GEMINI_MODEL=gemini-flash-latest
# Cheap model for the summary CLEAN and CLASSIFY passes
# GEMINI_CLEAN_MODEL=gemini-flash-lite-latest
# EMBEDDING_MODEL=gemini-embedding-2
# Truncated embedding width; rows of another width are ignored by search
# EMBEDDING_DIMS=768

# Python Whisper service (must match ai-service AI_SERVICE_PORT)
# AI_SERVICE_URL=http://localhost:8000

# Single origin, or * to allow any
# CORS_ORIGIN=*

# Upload handling (paths relative to backend/)
# UPLOAD_DIR=uploads/meetings
# LIVE_CHUNK_DIR=uploads/live
# MAX_UPLOAD_MB=500
# MAX_CHUNK_MB=25
# TRANSCRIPTION_TIMEOUT_MINUTES=15

# Live capture
# ROLLING_SUMMARY_MINUTES=7
# LIVE_SESSION_IDLE_MINUTES=10

# Shared secret recorders send as `Authorization: Bearer <token>` on
# /api/live. Optional in development (requests pass with a warning);
# REQUIRED when NODE_ENV=production, or the backend refuses to boot.
# DEVICE_TOKEN=
