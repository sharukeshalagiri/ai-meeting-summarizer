# Copy to .env and fill in real values. Never commit .env.

# --- required ---

# PostgreSQL connection string
DATABASE_URL="postgresql://user:password@localhost:5432/ai_meeting_summarizer"

# Google AI Studio API key (https://aistudio.google.com/apikey)
GEMINI_API_KEY=

# --- optional (defaults shown) ---

# NODE_ENV=development
# PORT=5000
# LOG_LEVEL=debug

# Gemini model used for summaries
# GEMINI_MODEL=gemini-flash-latest

# Python Whisper service
# AI_SERVICE_URL=http://localhost:8000

# Comma-free single origin, or * to allow any
# CORS_ORIGIN=*

# Upload handling
# UPLOAD_DIR=uploads/meetings
# MAX_UPLOAD_MB=500
# TRANSCRIPTION_TIMEOUT_MINUTES=15
