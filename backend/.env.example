# Copy to backend/.env and fill in real values. Never commit .env.

# --- required ---

# PostgreSQL connection string. Matches docker-compose.yml defaults
# (host port 5433). Give each git worktree its own database name, e.g.
# ai_meeting_summarizer_feat_auth (see CLAUDE.md, "Parallel worktrees").
DATABASE_URL="postgresql://postgres:postgres@localhost:5433/ai_meeting_summarizer"

# Google AI Studio API key (https://aistudio.google.com/apikey)
GEMINI_API_KEY=

# --- optional (defaults shown) ---

# NODE_ENV=development
# HTTP port. Change per worktree and update frontend VITE_API_URL to match.
# PORT=5000
# debug | info | warn | error (default: debug, info in production)
# LOG_LEVEL=debug

# Gemini models
# GEMINI_MODEL=gemini-flash-latest
# Cheap model for the summary CLEAN and CLASSIFY passes
# GEMINI_CLEAN_MODEL=gemini-flash-lite-latest
# EMBEDDING_MODEL=gemini-embedding-2
# Truncated embedding width; rows of another width are ignored by search
# EMBEDDING_DIMS=768

# Python Whisper service (must match ai-service AI_SERVICE_PORT)
# AI_SERVICE_URL=http://localhost:8000

# Single origin, or * to allow any
# CORS_ORIGIN=*

# Upload handling (paths relative to backend/)
# UPLOAD_DIR=uploads/meetings
# LIVE_CHUNK_DIR=uploads/live
# MAX_UPLOAD_MB=500
# MAX_CHUNK_MB=25
# TRANSCRIPTION_TIMEOUT_MINUTES=15

# Live capture
# ROLLING_SUMMARY_MINUTES=7
# LIVE_SESSION_IDLE_MINUTES=10

# DEPRECATED and ignored (w4-acct): recorders now use per-user device
# tokens from the web app's Devices page.
# DEVICE_TOKEN=

# Transcription provider: local (ai-service, faster-whisper; free) or
# deepgram (hosted, PAID per audio minute; needs DEEPGRAM_API_KEY).
# TRANSCRIPTION_PROVIDER=local
# DEEPGRAM_API_KEY=
# DEEPGRAM_MODEL=nova-2

# Speaker diarization (w2-spk): voice (ai-service speaker embeddings,
# free, default; falls back to text when the ai-service has no model),
# text (Gemini infers turns from the conversation), or deepgram (PAID per
# audio minute; needs DEEPGRAM_API_KEY).
# DIARIZATION_PROVIDER=voice
# Label for your own (mic channel) lines until you rename them.
# ME_DISPLAY_NAME=You

# Background jobs (w3-jobs): pgboss (durable, in Postgres; creates its
# own "pgboss" schema) or memory (in-process, lost on restart).
# JOBS_DRIVER=pgboss
# Recordings and job artifacts: local disk under STORAGE_DIR (relative
# to backend/). An S3-compatible driver can be added behind lib/storage.
# STORAGE_DRIVER=local
# STORAGE_DIR=uploads

# --- Accounts (w4-acct) ---
# Signs the session cookie. REQUIRED when NODE_ENV=production (at least
# 32 characters: openssl rand -hex 32); development uses a placeholder.
# SESSION_SECRET=
# Days a login lasts without activity (rolling).
# SESSION_MAX_AGE_DAYS=30
# Self-service sign-up. Default: on in development, off in production
# (create the account with: npm --prefix backend run user:password).
# AUTH_ALLOW_SIGNUP=
# Email export ("email this summary"). Unset SMTP_HOST = email off.
# SMTP_HOST=
# SMTP_PORT=587
# SMTP_SECURE=false
# SMTP_USER=
# SMTP_PASSWORD=
# SMTP_FROM=Meeting Companion <no-reply@example.com>
# When the audio-retention job runs (cron, UTC). Default: hourly.
# RETENTION_CRON=17 * * * *

# --- Live assembly (w3-jobs) ---
# ffmpeg joins a live session's chunks into one recording at /end.
# Without it the final pass is skipped and the live draft is summarized.
# FFMPEG_PATH=ffmpeg

# --- Demo mode and public-instance limits (w5-demo) ---
# "Try the demo" on the sign-in page signs visitors into the read-only
# demo account (seed it first: npm --prefix backend run demo:seed).
# DEMO_MODE=false
# Hours a demo sign-in lasts.
# DEMO_SESSION_HOURS=2
# Per-client rate limits on /api (per user, or per IP when signed out).
# Default: on in production, off elsewhere.
# RATE_LIMIT_ENABLED=
# RATE_LIMIT_PER_MINUTE=300
# Uploads, processing, chat, sign-ins and live starts, per hour.
# RATE_LIMIT_HEAVY_PER_HOUR=60
# Longest recording (or live capture) processed, in minutes; 0 = no cap.
# Default: 180 in production, 0 elsewhere. Needs ffprobe (ships with ffmpeg).
# MAX_AUDIO_MINUTES=
# FFPROBE_PATH=ffprobe
# demo:seed voices: auto (SAPI on Windows, else espeak-ng/espeak, else
# tones) | sapi | espeak | tones.
# DEMO_TTS=auto
